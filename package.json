{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -n mastra,octocat -c blue,magenta \"npm:mastra:dev\" \"npm:octocat:dev\"",
    "mastra:dev": "mastra dev",
    "octocat:dev": "npm --prefix src/octocat-app start",
    "build": "mastra build",
    "start": "mastra start"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.79.0",
    "@mastra/duckdb": "^1.15.0",
    "@mastra/libsql": "^1.27.0",
    "@mastra/mcp": "2.5.0",
    "@mastra/observability": "^1.21.0",
    "dotenv": "17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "concurrently": "^10.0.6",
    "mastra": "1.35.0",
    "typescript": "^6.0.3"
  }
}
